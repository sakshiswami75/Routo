generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ParcelStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryStatus {
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  walletBalance  Float @default(0)
  totalEarnings  Float @default(0)
  totalWithdrawn Float @default(0)

  // Relations
  sentParcels        Parcel[]            @relation("SenderParcels")
  deliveries         Delivery[]          @relation("CarrierDeliveries")
  routes             Route[]             @relation("TravelerRoutes")
  sentReviews        Review[]            @relation("SenderReviews")
  receivedReviews    Review[]            @relation("CarrierReviews")
  walletTransactions WalletTransaction[] @relation("UserWalletTransactions")
}

model Parcel {
  id             String       @id @default(uuid())
  title          String
  description    String?
  pickupLocation String
  dropLocation   String
  receiverName   String?
  receiverPhone  String?
  dropAddress    String?
  dropLandmark   String?
  status         ParcelStatus @default(PENDING)
  weight         Float
  rewardAmount   Float
  senderId       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  sender   User      @relation("SenderParcels", fields: [senderId], references: [id])
  delivery Delivery?

  // Indexes for query performance
  @@index([senderId])
  @@index([status])
}

model Delivery {
  id          String         @id @default(uuid())
  parcelId    String         @unique
  carrierId   String
  status      DeliveryStatus @default(ACCEPTED)
  acceptedAt  DateTime       @default(now())
  deliveredAt DateTime?

  // Relations
  parcel             Parcel              @relation(fields: [parcelId], references: [id])
  carrier            User                @relation("CarrierDeliveries", fields: [carrierId], references: [id])
  review             Review?
  walletTransactions WalletTransaction[]
  otp                DeliveryOTP?

  // Indexes
  @@index([carrierId])
  @@index([status])
}

model Route {
  id                String   @id @default(uuid())
  fromCity          String
  toCity            String
  vehicleType       String
  availableCapacity Float
  travelDate        DateTime
  travelerId        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  traveler User @relation("TravelerRoutes", fields: [travelerId], references: [id])

  // Indexes
  @@index([travelerId])
  @@index([fromCity, toCity])
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?
  senderId   String
  carrierId  String
  deliveryId String   @unique
  createdAt  DateTime @default(now())

  // Relations
  sender   User     @relation("SenderReviews", fields: [senderId], references: [id])
  carrier  User     @relation("CarrierReviews", fields: [carrierId], references: [id])
  delivery Delivery @relation(fields: [deliveryId], references: [id])

  // Indexes
  @@index([senderId])
  @@index([carrierId])
}

model WalletTransaction {
  id              String            @id @default(uuid())
  userId          String
  deliveryId      String?
  amount          Float
  transactionType TransactionType
  status          TransactionStatus @default(PENDING)
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  user     User      @relation("UserWalletTransactions", fields: [userId], references: [id])
  delivery Delivery? @relation(fields: [deliveryId], references: [id])

  // Indexes
  @@index([userId])
  @@index([deliveryId])
}

model DeliveryOTP {
  id           String   @id @default(uuid())
  deliveryId   String   @unique
  otp          String
  expiresAt    DateTime
  verified     Boolean  @default(false)
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  delivery Delivery @relation(fields: [deliveryId], references: [id])
}
