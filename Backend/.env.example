# Database Configuration
# Provide a valid PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/routo_db?schema=public"

# Server Configuration
PORT=3000

# Authentication
# Provide a secure, random string (e.g., generated via `openssl rand -base64 32`)
JWT_SECRET="replace_with_your_secure_random_jwt_secret"
JWT_EXPIRES_IN="1d"
